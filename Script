local estimating = false
function refreshEstimate()
if estimating then return end
estimating = true
refreshBtn.Text = "SCANNING"
refreshBtn.TextColor3 = C.ACCENT
task.spawn(function()
local bytes, count, assets = 0, 0, 0
for _, d in ipairs(game:GetDescendants()) do
count += 1
local cls = d.ClassName
if cls == "MeshPart" then bytes += 2000; assets += 1
elseif cls == "Part" or cls == "WedgePart" or cls == "TrussPart"
or cls == "CornerWedgePart" or cls == "SpawnLocation" then
bytes += 600
if d:FindFirstChildOfClass("Decal") or d:FindFirstChildOfClass("Texture") then assets += 1 end
if d:FindFirstChildOfClass("SpecialMesh") then assets += 1 end
elseif cls == "Decal" or cls == "Texture" then bytes += 300; assets += 1
elseif cls == "SurfaceAppearance" then bytes += 800; assets += 3
elseif cls == "Terrain" then
if opts.includeTerrain then bytes += 8000 end
elseif cls == "TextLabel" or cls == "TextButton" or cls == "TextBox" then bytes += 350
elseif cls == "ImageLabel" or cls == "ImageButton" then bytes += 300; assets += 1
elseif cls == "Frame" or cls == "ScrollingFrame" then bytes += 250
elseif cls == "Sound" then
if opts.includeSounds then bytes += 200; assets += 1 end
elseif cls == "ParticleEmitter" or cls == "Trail" or cls == "Beam" then bytes += 400
elseif cls == "Script" or cls == "LocalScript" or cls == "ModuleScript" then
if not opts.excludeScripts then
local ok, src = pcall(function() return d.Source end)
bytes += (ok and #tostring(src) or 500)
end
else bytes += 180
end
end
if opts.cacheAssets then bytes = bytes * 1.4 end
if opts.ignoreDefaults then bytes = bytes * 0.6 end
estimateMain.Text = fmtBytes(math.floor(bytes))
estimateSub.Text = string.format("%s instances | %s assets",
tostring(count), tostring(assets))
estimating = false
refreshBtn.Text = "REFRESH"
refreshBtn.TextColor3 = C.TEXT_DIM
end)
end
