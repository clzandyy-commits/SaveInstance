-- ─── Helpers ───────────────────────────────────────────────────
local function corner(p, r)
local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r or 6); c.Parent = p
return c
end

local function stroke(p, col, t)
local s = Instance.new("UIStroke")
s.Color = col or C.BORDER
s.Thickness = t or 1
s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
s.Parent = p
return s
end

local function mk(parent, class, props)
local i = Instance.new(class)
for k, v in pairs(props) do i[k] = v end
i.Parent = parent
return i
end

local function draggable(f)
local on, s0, p0
f.InputBegan:Connect(function(i)
if i.UserInputType == Enum.UserInputType.MouseButton1
or i.UserInputType == Enum.UserInputType.Touch then
on = true; s0 = i.Position; p0 = f.Position
end
end)
UIS.InputChanged:Connect(function(i)
if on and (i.UserInputType == Enum.UserInputType.MouseMovement
or i.UserInputType == Enum.UserInputType.Touch) then
local d = i.Position - s0
f.Position = UDim2.new(p0.X.Scale, p0.X.Offset + d.X,
p0.Y.Scale, p0.Y.Offset + d.Y)
end
end)
UIS.InputEnded:Connect(function(i)
if i.UserInputType == Enum.UserInputType.MouseButton1
or i.UserInputType == Enum.UserInputType.Touch then on = false end
end)
end

local function fmtBytes(n)
if not n then return "--" end
if n < 1024 then return n .. " B" end
if n < 1048576 then return string.format("%.1f KB", n / 1024) end
if n < 1073741824 then return string.format("%.2f MB", n / 1048576) end
return string.format("%.2f GB", n / 1073741824)
end

local function fmtTime(s)
s = math.floor(s)
if s < 60 then return s .. "s" end
return string.format("%dm %02ds", math.floor(s / 60), s % 60)
end

local function safeFileSize(path)
if CAP.getsize then
local ok, s = pcall(getsize, path)
if ok and type(s) == "number" then return s end
end
if not CAP.readfile then return nil end
local ok, content = pcall(readfile, path)
if not ok or not content then return nil end
return #content
end

local function ensureFolder(path)
if not CAP.makefolder then return end
local cur = ""
for seg in path:gmatch("[^/]+") do
cur = (cur == "") and seg or (cur .. "/" .. seg)
if CAP.isfolder and not isfolder(cur) then pcall(makefolder, cur) end
end
end

