local function scanOutput(folder)
folder = folder or "SaveInstance"
if not CAP.isfolder or not isfolder(folder) then
outPathLabel.Text = "Folder not found"
return
end
lastFolderPath = folder
outPathLabel.Text = folder
for _, c in ipairs(outScroll:GetChildren()) do
if c:IsA("Frame") or c:IsA("TextLabel") then c:Destroy() end
end
if not CAP.listfiles then
outTotalLabel.Text = "listfiles unavailable"
return
end
local ok, files = pcall(listfiles, folder)
if not ok or type(files) ~= "table" then
outTotalLabel.Text = "read error"
return
end
local entries = {}
for _, f in ipairs(files) do
if CAP.isfile and not isfile(f) then continue end
local size = safeFileSize(f) or 0
table.insert(entries, { path = f, name = f:match("[^/\]+$") or f, size = size })
end
table.sort(entries, function(a, b) return a.size > b.size end)
local total = 0
for i, f in ipairs(entries) do
total += f.size
local row = mk(outScroll, "Frame", {
Size = UDim2.new(1, 0, 0, 24),
BackgroundTransparency = 1,
LayoutOrder = i,
})
mk(row, "TextLabel", {
Size = UDim2.new(1, -100, 1, 0),
BackgroundTransparency = 1,
Text = f.name,
TextColor3 = C.TEXT,
TextSize = 11,
Font = F.MONO,
TextXAlignment = Enum.TextXAlignment.Left,
TextTruncate = Enum.TextTruncate.AtEnd,
})
mk(row, "TextLabel", {
Size = UDim2.new(0, 90, 1, 0),
Position = UDim2.new(1, -90, 0, 0),
BackgroundTransparency = 1,
Text = fmtBytes(f.size),
TextColor3 = C.TEXT_DIM,
TextSize = 11,
Font = F.MONO,
TextXAlignment = Enum.TextXAlignment.Right,
})
end
if #entries == 0 then
mk(outScroll, "TextLabel", {
Size = UDim2.new(1, 0, 0, 20),
BackgroundTransparency = 1,
Text = "Empty folder",
TextColor3 = C.TEXT_MUT,
TextSize = 11,
Font = F.REG,
LayoutOrder = 1,
})
end
task.defer(function()
outScroll.CanvasSize = UDim2.new(0, 0, 0, outLayout.AbsoluteContentSize.Y + 12)
end)
outTotalLabel.Text = string.format("%s | %d files", fmtBytes(total), #entries)
end

