-- CONSOLE capture
-- ═══════════════════════════════════════════════════════════════

local MAX_LOGS = 500
local logs = {}
local listeners = {}
local queue = {}

local function kindOf(mt)
if mt == Enum.MessageType.MessageError then return "ERR" end
if mt == Enum.MessageType.MessageWarning then return "WARN" end
if mt == Enum.MessageType.MessageOutput then return "OUT" end
return "INFO"
end

local function pushLog(msg, kind, time)
local entry = { msg = msg, kind = kind, time = time or os.time() }
table.insert(logs, entry)
if #logs > MAX_LOGS then table.remove(logs, 1) end
for _, fn in ipairs(listeners) do pcall(fn, entry) end
end

pcall(function()
for _, e in ipairs(LogService:GetLogHistory()) do
table.insert(logs, { msg = e.message, kind = kindOf(e.messageType), time = e.timestamp })
end
while #logs > MAX_LOGS do table.remove(logs, 1) end
end)

LogService.MessageOut:Connect(function(msg, mt)
table.insert(queue, { msg = msg, kind = kindOf(mt) })
end)

RunService.Heartbeat:Connect(function()
if #queue == 0 then return end
local batch = math.min(20, #queue)
for i = 1, batch do
local e = table.remove(queue, 1)
pushLog(e.msg, e.kind)
end
end)

